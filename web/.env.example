# Copy to `web/.env.local` (gitignored) and fill in.
#
# Every VITE_-prefixed variable is inlined into the client bundle and is
# therefore PUBLIC. EmailJS public keys are designed for that, but you must
# enable the domain allow-list in the EmailJS dashboard so the key cannot be
# used from another origin.

# Production origin, no trailing slash. Drives canonical/OG/JSON-LD/sitemap.
# When you set this, update the matching absolute URLs in web/index.html too —
# index.html cannot read import.meta.env. A test asserts the two agree.
VITE_SITE_ORIGIN=https://manrajsingh.dev

# EmailJS — https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Resolve the contact form locally without sending mail. A message starting
# with "fail" simulates a provider error, so both paths are exercisable.
VITE_CONTACT_FAKE=true
